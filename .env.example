# Kopeeri see fail nimega .env.local ja täida väärtused.
# Ühine dev-projekt: Supabase → Project Settings → API (URL ja publishable/anon võti).
# Lokaalse Supabase'i jaoks: `npx supabase start` näitab URL-i ja anon võtit.
NEXT_PUBLIC_SUPABASE_URL=https://diiftdfkcrhfpyuxnkde.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ainult andmebaasi testidele (npm run test:db:api), rakendus seda ei kasuta.
# Lokaalselt: postgresql://postgres:postgres@127.0.0.1:54322/postgres (vt `npx supabase status`).
# Ühise projekti parooli ära pane kuhugi mujale kui .env.local-i.
SUPABASE_DB_URL=
